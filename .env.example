# Copie este arquivo para .env e preencha com os dados do seu projeto Supabase.
# Project URL: Project Settings > Data API
# Chave: Project Settings > API Keys > "Publishable key" (ou a chave "anon" legada)
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sua-publishable-key
